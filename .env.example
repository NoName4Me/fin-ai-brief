DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/fin_ai_brief
SITE_URL=http://localhost:3100
# 至少12位；仅服务端使用，不提交实际配置
ADMIN_PASSWORD=
# OpenAI 兼容接口，包含 /v1 等 API 前缀；模型名使用服务商的完整标识
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 自动采集在管理台出刊设置中开启，默认关闭。模型调用需要有效 API Key
MODEL_CALLS_ENABLED=false
# QQ邮箱：先在网页端开启SMTP服务并生成授权码
# SMTP_USER填完整QQ邮箱；SMTP_PASSWORD填授权码；MAIL_FROM填同一邮箱
MAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 订阅退订链接签名；部署后保持稳定
APP_SECRET=

# 仅当本机代理把公网域名解析到198.18/15时开启，正常DNS环境保持关闭
SOURCE_FAKE_IP_ENABLED=false

# 剑鱼标讯搜索接口。RSA私钥来自站点页面解密脚本，站点更新后需同步替换
JIANYU_RSA_PRIVATE_KEY=
# 仅当站点要求登录态时配置浏览器 Cookie
JIANYU_COOKIE=
