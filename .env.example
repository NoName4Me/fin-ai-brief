DATABASE_URL=postgres://fin_ai_brief:change-me@127.0.0.1:5432/fin_ai_brief
SITE_URL=http://localhost:3100
# 至少12位；仅服务端使用，不提交实际配置
ADMIN_PASSWORD=
# OpenAI 兼容接口，包含 /v1 等 API 前缀；模型名使用服务商的完整标识
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 自动采集在管理台出刊设置中开启，默认关闭。模型调用需要有效 API Key
MODEL_CALLS_ENABLED=false
# 正式发信待选定服务商；未开启时只登记订阅
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 订阅退订链接签名；部署后保持稳定
APP_SECRET=

# 仅当本机代理把公网域名解析到198.18/15时开启，正常DNS环境保持关闭
SOURCE_FAKE_IP_ENABLED=false

# 机器之心官方RSS令牌，仅服务端使用；信源地址不包含token
JIQIZHIXIN_RSS_TOKEN=
