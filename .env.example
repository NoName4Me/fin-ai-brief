DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/fin_ai_brief
SITE_URL=http://localhost:3100
# 至少12位；仅服务端使用，不提交实际配置
ADMIN_PASSWORD=
# 模型地址、密钥、模型名称及调用开关在管理端「系统设置」配置
# SMTP 连接与发件人在管理端「订阅与推送 → 推送配置」设置

# 订阅退订链接签名；部署后保持稳定
APP_SECRET=

# 仅当本机代理把公网域名解析到198.18/15时开启，正常DNS环境保持关闭
SOURCE_FAKE_IP_ENABLED=false

# 剑鱼标讯搜索接口。RSA私钥来自站点页面解密脚本，站点更新后需同步替换
JIANYU_RSA_PRIVATE_KEY=
# 仅当站点要求登录态时配置浏览器 Cookie
JIANYU_COOKIE=

# 资讯初筛试运行：填写带时区的开始时间，仅抽取此后采集的约 10% 资讯；留空关闭
ARTICLE_SCREENING_TRIAL_START=
